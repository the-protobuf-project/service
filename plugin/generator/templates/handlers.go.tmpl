// {{ .GoName }}Handlers answer {{ .FullName }}: one per RPC, the request in
// and the response out -- a query of your database, a call to another
// service, any business logic. {{ .GoName }}Server runs each standard method's
// checks and hooks around its handler, so a handler never sees a request
// those checks refused, and every custom method straight to its own.
//
// A handler returns the standard outcomes as servicex.ErrNotFound,
// ErrAlreadyExists, ErrConflict (an etag that no longer matches) and
// ErrInvalidArgument, or errors wrapping them; a *problem.Problem or a gRPC
// status for anything else. Handlers that write enforce the etag in the
// write.
type {{ .GoName }}Handlers struct {
{{- range .Handlers }}
	// {{ .GoName }} answers {{ .GoName }}.
	{{ .GoName }} {{ .Sig }}
{{- end }}
}

// Missing are the RPCs h has no handler for.
func (h {{ .GoName }}Handlers) Missing() []string {
	var out []string
{{- range .Handlers }}
	if h.{{ .GoName }} == nil {
		out = append(out, {{ quote .GoName }})
	}
{{- end }}
	return out
}

// {{ .GoName }}Hooks is the business logic {{ .GoName }}Server runs around its
// standard methods' handlers. Embed Nop{{ .GoName }}Hooks and implement only
// the hooks you need. An error a hook returns fails the call, rendered by the
// server's problem.Translator: a *problem.Problem (servicex.BadField, Missing,
// Blocked), an error wrapping a registered sentinel, or a gRPC status.
type {{ .GoName }}Hooks interface {
{{- range .Hooks }}
	// {{ .Doc }}
	{{ .Name }}({{ .Params }}) error
{{- end }}
}

// Nop{{ .GoName }}Hooks implements every hook as doing nothing.
type Nop{{ .GoName }}Hooks struct{}

var _ {{ .GoName }}Hooks = Nop{{ .GoName }}Hooks{}
{{ range .Hooks }}
// {{ .Name }} does nothing.
func (Nop{{ $s.GoName }}Hooks) {{ .Name }}({{ .Params }}) error { return nil }
{{ end }}
// {{ .GoName }}Server serves {{ .FullName }}: each standard method's
// generated checks and hooks around its handler, and every custom method
// straight to its own. To replace a method, embed *{{ .GoName }}Server in a
// type of your own and define it there.
type {{ .GoName }}Server struct {
	{{ .Grpc }}.Unimplemented{{ .GoName }}Server

	handlers {{ .GoName }}Handlers
	hooks    {{ .GoName }}Hooks
	opts     servicex.Options
}

var _ {{ .Grpc }}.{{ .GoName }}Server = (*{{ .GoName }}Server)(nil)

// New{{ .GoName }}Server returns the {{ .GoName }}Server answering through
// handlers and running hooks (nil runs none), or a *servicex.MissingHandlers
// naming every RPC handlers leave unanswered. Errors carry the ErrorInfo
// domain {{ quote .Domain }} unless servicex.WithTranslator says otherwise.
func New{{ .GoName }}Server(handlers {{ .GoName }}Handlers, hooks {{ .GoName }}Hooks, opts ...servicex.Option) (*{{ .GoName }}Server, error) {
	if missing := handlers.Missing(); len(missing) > 0 {
		return nil, &servicex.MissingHandlers{Service: {{ quote .FullName }}, Methods: missing}
	}
	if hooks == nil {
		hooks = Nop{{ .GoName }}Hooks{}
	}
	return &{{ .GoName }}Server{
		handlers: handlers,
		hooks:    hooks,
		opts:     servicex.Apply(servicex.Options{Translator: servicex.NewTranslator({{ quote .Domain }})}, opts),
	}, nil
}

// Options are the server's options, for a method of your own that traces
// and renders its errors the way the generated ones do (Options().Run).
func (s *{{ .GoName }}Server) Options() servicex.Options { return s.opts }

// Handlers are the handlers the server answers through.
func (s *{{ .GoName }}Server) Handlers() {{ .GoName }}Handlers { return s.handlers }
