{{- define "hUpdate" }}{{ $s := .S }}{{ $m := .M }}{{ $r := .R }}
// {{ $m.GoName }} is AIP-134's Update: the name and update_mask ("*" for every
// mutable field, absent for the ones the request sets){{ if $m.Get }}; then, with the stored
// record ({{ $m.Get.GoName }}), its etag, IMMUTABLE fields, the merge and REQUIRED
// fields{{ if $m.AllowMissing }}, or allow_missing's create{{ end }}{{ end }}. Validate and BeforeUpdate see the record to
// write; validate_only returns it unwritten. The handler receives it, carrying
// the request's etag to guard its write, with the canonical mask.
func (s *{{ $s.GoName }}Server) {{ $m.GoName }}(ctx context.Context, req *{{ $m.Req }}) (*{{ $m.Resp }}, error) {
	var out *{{ $m.Resp }}
	err := s.opts.Run(ctx, {{ quote $s.GoName }}, {{ quote $m.GoName }}, func(ctx context.Context) (err error) {
		in := req.{{ $m.Body }}
		if in == nil {
			return servicex.BadField(servicex.ReasonRequiredField, {{ quote $m.BodyField }}, "{{ $m.BodyField }} is required", "Send the {{ $r.Singular }} to write")
		}
		name := in.GetName()
		if err := servicex.CheckName("{{ $m.BodyField }}.name", name, false, {{ $r.Var }}Collections...); err != nil {
			return err
		}
		paths, err := servicex.UpdatePaths(in, {{ if $m.UpdateMask }}req.{{ $m.UpdateMask }}{{ else }}nil{{ end }}, {{ quote $m.BodyField }}, {{ $r.Var }}OutputOnly)
		if err != nil {
			return err
		}
		write := proto.Clone(req).(*{{ $m.Req }})
{{- if $m.Get }}
		existing, err := s.handlers.{{ $m.Get.GoName }}(ctx, &{{ $m.Get.Req }}{ {{- $m.Get.NameGo }}: name})
{{- if $m.AllowMissing }}
		if req.{{ $m.AllowMissing }} && servicex.IsNotFound(err) {
			// AIP-134 allow_missing: an update of nothing creates it, under
			// the id the name chooses, held to Create's rule.
			if err := servicex.CheckID("{{ $m.BodyField }}.name", servicex.IDOf(name)); err != nil {
				return err
			}
			created := proto.Clone(in).(*{{ $r.PB }})
			if err := s.prepare{{ $r.GoName }}(ctx, servicex.ParentOf(name), name, created); err != nil {
				return err
			}
{{- if $m.ValidateOnly }}
			if req.{{ $m.ValidateOnly }} {
				out = created
				return nil
			}
{{- end }}
			write.{{ $m.BodyGo }} = created
			out, err = s.handlers.{{ $m.GoName }}(ctx, write)
			if err != nil {
				return servicex.AlreadyExistsAs(err, {{ $r.Var }}Type, name, "Read it, then update it")
			}
			return s.hooks.AfterCreate{{ $r.GoName }}(ctx, out)
		}
{{- end }}
		if err != nil {
			return servicex.NotFoundAs(err, {{ $r.Var }}Type, name)
		}
{{- if $r.HasEtag }}
		if err := servicex.CheckEtag({{ $r.Var }}Type, name, in.GetEtag(), existing.GetEtag()); err != nil {
			return err
		}
{{- end }}
{{- if $r.HasImmut }}
		if err := servicex.CheckImmutable({{ quote $m.BodyField }}, existing, in, paths, {{ $r.Var }}Immutable); err != nil {
			return err
		}
{{- end }}
		merged := proto.Clone(existing).(*{{ $r.PB }})
		servicex.MergeMutable(merged, in, paths, {{ $r.Var }}OutputOnly)
		if err := servicex.Required(merged, {{ quote $m.BodyField }}, {{ $r.Var }}Required); err != nil {
			return err
		}
{{- else }}
		// No Get to read the stored record with: REQUIRED is checked on the
		// fields the mask writes, and the etag, IMMUTABLE fields and the
		// merge are the handler's.
		if err := servicex.Required(in, {{ quote $m.BodyField }}, servicex.Selected(paths, {{ $r.Var }}Required)); err != nil {
			return err
		}
		merged := proto.Clone(in).(*{{ $r.PB }})
{{- end }}
		if err := s.hooks.Validate{{ $r.GoName }}(ctx, servicex.OpUpdate, merged, paths); err != nil {
			return err
		}
		if err := s.hooks.BeforeUpdate{{ $r.GoName }}(ctx, merged, paths); err != nil {
			return err
		}
{{- if $m.ValidateOnly }}
		if req.{{ $m.ValidateOnly }} {
			out = merged
			return nil
		}
{{- end }}
{{- if and $m.Get $r.HasEtag }}
		// The caller's etag, not the stored one: the handler guards its
		// write with it.
		merged.Etag = in.GetEtag()
{{- end }}
		write.{{ $m.BodyGo }} = merged
{{- if $m.MaskGo }}
		write.{{ $m.MaskGo }} = servicex.Mask(paths)
{{- end }}
		out, err = s.handlers.{{ $m.GoName }}(ctx, write)
		if err != nil {
			return servicex.NotFoundAs(err, {{ $r.Var }}Type, name)
		}
		return s.hooks.AfterUpdate{{ $r.GoName }}(ctx, out)
	})
	if err != nil {
		return nil, err
	}
	return out, nil
}
{{ end }}

{{- define "hDelete" }}{{ $s := .S }}{{ $m := .M }}{{ $r := .R }}
