{{- if $m.ValidateOnly }}
		if req.{{ $m.ValidateOnly }} {
{{- if and (not $m.ReturnsEmpty) $m.Get }}
			out = existing
{{- end }}
			return nil
		}
{{- end }}
		res, err := s.handlers.{{ $m.GoName }}(ctx, req)
{{- if $m.AllowMissing }}
		if req.{{ $m.AllowMissing }} && servicex.IsNotFound(err) {
