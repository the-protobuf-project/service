{{- define "hCreate" }}{{ $s := .S }}{{ $m := .M }}{{ $r := .R }}
// {{ $m.GoName }} is AIP-133's Create: {{ if $m.ID }}the id (AIP-122; empty leaves it to the
// handler) and {{ end }}the parent, then the {{ $r.Singular }} readied for its handler
// (prepare{{ $r.GoName }}); validate_only returns it unwritten. AfterCreate runs over
// what the handler wrote.
func (s *{{ $s.GoName }}Server) {{ $m.GoName }}(ctx context.Context, req *{{ $m.Req }}) (*{{ $m.Resp }}, error) {
	var out *{{ $m.Resp }}
	err := s.opts.Run(ctx, {{ quote $s.GoName }}, {{ quote $m.GoName }}, func(ctx context.Context) (err error) {
		if req.{{ $m.Body }} == nil {
			return servicex.BadField(servicex.ReasonRequiredField, {{ quote $m.BodyField }}, "{{ $m.BodyField }} is required", "Send the {{ $r.Singular }} to write")
		}
		in := proto.Clone(req.{{ $m.Body }}).(*{{ $r.PB }})
{{- if $r.Parented }}
		parent := req.{{ $m.Parent }}
		if err := servicex.CheckName("parent", parent, false, {{ $r.Var }}Parent...); err != nil {
			return err
		}
{{- else }}
