// prepare{{ $r.GoName }} readies in for its handler as AIP-133 creates it
// under parent, named name ("" leaves the id to the handler): its
// OUTPUT_ONLY fields cleared, its REQUIRED ones present, through ParentCheck,
// Validate and BeforeCreate. Create{{ $r.GoName }} and an allow_missing
// update share it.
func (s *{{ $s.GoName }}Server) prepare{{ $r.GoName }}(ctx context.Context, parent, name string, in *{{ $r.PB }}) error {
	servicex.ClearOutputOnly(in, {{ $r.Var }}OutputOnly)
	in.Name = name
	if err := servicex.Required(in, {{ quote $r.Singular }}, {{ $r.Var }}Required); err != nil {
		return err
	}
{{- if $r.Parented }}
	if err := s.hooks.ParentCheck{{ $r.GoName }}(ctx, servicex.OpCreate, parent); err != nil {
		return err
	}
{{- end }}
	if err := s.hooks.Validate{{ $r.GoName }}(ctx, servicex.OpCreate, in, nil); err != nil {
		return err
	}
	return s.hooks.BeforeCreate{{ $r.GoName }}(ctx, parent, in)
}
{{- end }}
{{ end }}

{{- define "hGet" }}{{ $s := .S }}{{ $m := .M }}{{ $r := .R }}
