{{ .Banner }}

package app

import (
{{- range .Imports }}
	{{ . }}
{{- end }}
)

// Stamped at link time (-ldflags "-X {{ .App }}.buildVersion=v1.2.3
// -X {{ .App }}.buildCommit=$(git rev-parse HEAD)"): the release tag and
// the commit it was built from. Empty in an unstamped build.
var (
	buildVersion string
	buildCommit  string
)

// buildRevision is the commit the binary was built from: the stamp, else the
// VCS revision `go build` records, else "dev".
func buildRevision() string {
	if buildCommit != "" {
		return buildCommit
	}
	if info, ok := debug.ReadBuildInfo(); ok {
		for _, s := range info.Settings {
			if s.Key == "vcs.revision" && s.Value != "" {
				return s.Value
			}
		}
	}
	return "dev"
}

// versionString is what `{{ .Name }} --version` prints: the stamped release
// tag (or "dev") and the commit.
func versionString() string {
	version := buildVersion
	if version == "" {
		version = "dev"
	}
	return fmt.Sprintf("{{ .Name }} %s (commit %s)", version, buildRevision())
}
