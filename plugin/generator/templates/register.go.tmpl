{{ .Banner }}

package {{ .Package }}

import (
{{- range .Imports }}
	{{ . }}
{{- end }}
)

// Servers are the servers of this package a process serves; a nil one is
// left out. Each may be a generated server, or a type of your own embedding
// one.
type Servers struct {
{{- range .Services }}
	{{ .GoName }} {{ .Grpc }}.{{ .GoName }}Server
{{- end }}
}

// RegisterAll returns the runtime-go HybridServer options that serve s: each
// server on gRPC{{ if .Services }}, its REST gateway (grpc-gateway, dialing the
// hybrid server's own endpoint) and its MCP tools, where those bindings were
// generated{{ end }}. Pass them to grpc.NewHybridServer beside WithValidation,
// which keeps protovalidate in front of all three surfaces.
func RegisterAll(s Servers) []grpc.Option {
	var opts []grpc.Option
{{- range .Services }}
	if srv := s.{{ .GoName }}; srv != nil {
		opts = append(opts,
			grpc.WithGRPCServers(func(g *grpc.GRPCServer) { {{ .Grpc }}.Register{{ .GoName }}Server(g, srv) }),
{{- if .Gateway }}
			grpc.WithHTTPGateways(func(mux *grpc.ServeMux, endpoint string, dial []grpc.DialOption) error {
				return {{ .Gateway }}.Register{{ .GoName }}HandlerFromEndpoint(context.Background(), mux, endpoint, dial)
			}),
{{- end }}
{{- if .MCP }}
			grpc.WithMCPServices(func(ctx context.Context, cfg *grpc.MCPServerConfig) error {
				return {{ .MCP }}.Serve{{ .GoName }}MCP(ctx, srv, cfg)
			}),
{{- end }}
		)
	}
{{- end }}
	return opts
}

// RegisterGRPC registers s on a gRPC server alone: a standalone server, or
// the one an end-to-end test serves over bufconn.
func RegisterGRPC(g *grpc.GRPCServer, s Servers) {
{{- range .Services }}
	if s.{{ .GoName }} != nil {
		{{ .Grpc }}.Register{{ .GoName }}Server(g, s.{{ .GoName }})
	}
{{- end }}
}
