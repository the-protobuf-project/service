{{ .Banner }}

// Loading and validating the embedded + overlay TOML, at startup or on first
// use -- never at import.
package config

import (
{{- range .Imports }}
	{{ . }}
{{- end }}
)

// EnvPrefix starts every environment variable that overrides a configuration
// key: {{ .Env }}<SECTION>__<KEY>, double underscores between levels.
const EnvPrefix = "{{ .Env }}"

// Layers are TOML documents an application adds over the generated ones, for
// its own sections or to change a default: Release over the release
// defaults, Dev over the development profile. Set them before the first Load.
var Layers struct {
	Release [][]byte
	Dev     [][]byte
}

var (
	k            = koanf.New(".")
	loadedConfig *AppConfig
	loadErr      error
	loadOnce     sync.Once
)

// Load reads the configuration -- the embedded release defaults and
// Layers.Release, the development profile and Layers.Dev, then {{ .Env }}
// environment variables -- validates it, and keeps it for Get. It reads once:
// later calls return the first result.
func Load() (*AppConfig, error) {
	loadOnce.Do(func() { loadedConfig, loadErr = load() })
	return loadedConfig, loadErr
}

func load() (*AppConfig, error) {
	// 1. Embedded production defaults (always present), then the
	// application's own.
	data, err := configFS.ReadFile("{{ .Name }}.release.toml")
	if err != nil {
		return nil, fmt.Errorf("embedded config not found: %w", err)
	}
	for _, layer := range append([][]byte{data}, Layers.Release...) {
		if err := k.Load(rawbytes.Provider(layer), toml.Parser()); err != nil {
			return nil, fmt.Errorf("failed to load the release defaults: %w", err)
		}
	}

	// 2. The development profile: {{ .Name }}.dev.toml from the working
	// directory when it is there (a checkout, so edits apply without a
	// rebuild), else the embedded copy when {{ .Env }}PROFILE=dev asks for
	// it. {{ .Env }}PROFILE=release loads none, even in a checkout.
	var overlay []byte
	switch profile := os.Getenv(ProfileVar); profile {
	case "release":
	case "", "dev":
		var err error
		if overlay, err = os.ReadFile(devOverlayPath); err == nil || profile == "" {
			break
		}
		if overlay, err = configFS.ReadFile("{{ .Name }}.dev.toml"); err != nil {
			return nil, fmt.Errorf("embedded dev profile not found: %w", err)
		}
	default:
		return nil, fmt.Errorf("%s=%q: want dev or release", ProfileVar, profile)
	}
	if overlay != nil {
		for _, layer := range append([][]byte{overlay}, Layers.Dev...) {
			if err := k.Load(rawbytes.Provider(layer), toml.Parser()); err != nil {
				return nil, fmt.Errorf("failed to load the dev profile: %w", err)
			}
		}
	}

	// 3. Environment variables, last so they win: how a container with nothing
	// but the binary in it is configured. {{ .Env }}DATABASE__POSTGRES__HOST=db.
	if err := k.Load(env.Provider(".", env.Opt{
		Prefix: EnvPrefix,
		TransformFunc: func(key, v string) (string, any) {
			key = strings.ToLower(strings.TrimPrefix(key, EnvPrefix))
			if strings.Contains(key, "__") {
				return strings.ReplaceAll(key, "__", "."), v
			}
			return strings.ReplaceAll(key, "_", "."), v
		},
	}), nil); err != nil {
		return nil, fmt.Errorf("failed to load environment overrides: %w", err)
	}

	cfg := &AppConfig{}
	if err := k.UnmarshalWithConf("", cfg, koanf.UnmarshalConf{Tag: "koanf"}); err != nil {
		return nil, fmt.Errorf("failed to unmarshal config: %w", err)
	}
	if err := validate(cfg); err != nil {
		return nil, err
	}
	return cfg, nil
}

// validate refuses a configuration the server cannot run on.
func validate(cfg *AppConfig) error {
	if cfg.Meta.Name == "" || cfg.Meta.Version == "" {
		return fmt.Errorf("config invalid: name=%q version=%q", cfg.Meta.Name, cfg.Meta.Version)
	}
	if !cfg.Server.Environment.IsValid() {
		return fmt.Errorf("config invalid: server.environment=%q (want development|debug|staging|production)",
			cfg.Server.Environment)
	}
	if cfg.Server.EnableMCP && !validMCPTransport(cfg.Server.MCP.Transport) {
		return fmt.Errorf("config invalid: server.mcp.transport=%q (want stdio|streamable-http|sse)",
			cfg.Server.MCP.Transport)
	}
	if p := cfg.Server.MCP.Path; p != "" && !strings.HasPrefix(p, "/") {
		return fmt.Errorf("config invalid: server.mcp.path=%q (want an absolute path such as /mcp)", p)
	}
	if m := cfg.Database.Postgres.PlanCacheMode; m != "" && !slices.Contains(PlanCacheModes, m) {
		return fmt.Errorf("config invalid: database.postgres.plan_cache_mode=%q (want %s)", m, strings.Join(PlanCacheModes, "|"))
	}
	if cfg.Server.ShutdownTimeoutSeconds < 0 {
		return fmt.Errorf("config invalid: server.shutdown_timeout_seconds=%d (want 0 for the default, or more)", cfg.Server.ShutdownTimeoutSeconds)
	}
	// An environment variable sets a list as one comma-separated string.
	cors := &cfg.Server.CORS
	for _, list := range []*[]string{&cors.AllowedOrigins, &cors.AllowedMethods, &cors.AllowedHeaders, &cors.ExposedHeaders} {
		*list = splitList(*list)
	}
	if c := cfg.Server.CORS; c.Enabled {
		if len(c.AllowedOrigins) == 0 {
			return errors.New("config invalid: server.cors.enabled requires server.cors.allowed_origins")
		}
		if c.AllowCredentials && slices.Contains(c.AllowedOrigins, "*") {
			return errors.New(`config invalid: server.cors.allow_credentials cannot be combined with the "*" origin; list the origins instead`)
		}
		if c.MaxAgeSeconds < 0 {
			return fmt.Errorf("config invalid: server.cors.max_age_seconds=%d (want 0 or more)", c.MaxAgeSeconds)
		}
	}
	if cfg.Server.ExperimentalHTTP3 && !cfg.Server.TLS.Enabled() {
		return errors.New("config invalid: server.experimental_http3 requires server.tls.cert_file and server.tls.key_file")
	}
	return nil
}

// splitList splits each entry of list on commas, trimming spaces and dropping
// empty items, so ["a, b"] from an environment variable and ["a", "b"] from
// TOML read the same.
func splitList(list []string) []string {
	var out []string
	for _, entry := range list {
		for item := range strings.SplitSeq(entry, ",") {
			if item = strings.TrimSpace(item); item != "" {
				out = append(out, item)
			}
		}
	}
	return out
}

// validMCPTransport reports whether t is one of the supported MCP transports.
func validMCPTransport(t options.MCPTransport) bool {
	switch t {
	case options.MCPTransportStdio, options.MCPTransportStreamableHTTP, options.MCPTransportSSE:
		return true
	default:
		return false
	}
}

// Get returns the configuration, loading it on first use, and panics when it
// is invalid: for the server and its tools, which cannot run without it.
func Get() *AppConfig {
	cfg, err := Load()
	if err != nil {
		panic(err.Error())
	}
	return cfg
}

// Section unmarshals the section at key (dotted: "engine", "search.opensearch")
// into out, a pointer to a struct with koanf tags: how business logic reads a
// section the application declared in its own Layers. It loads the
// configuration first when nothing has.
func Section(key string, out any) error {
	if _, err := Load(); err != nil {
		return err
	}
	return k.UnmarshalWithConf(key, out, koanf.UnmarshalConf{Tag: "koanf"})
}
