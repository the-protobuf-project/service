// Package database owns {{ .Name }}'s connection plumbing: it opens the
// configured database, holds the live handle, and fans every write a
// repository commits out to the observers business logic registers -- a
// cache, a read model, an audit log. It is domain-agnostic: the server builds
// every repository from one Connection (Repox).
package database

import (
{{- range .Imports }}
	{{ . }}
{{- end }}
)

// Connection carries the live database handle and what every repository
// built from it shares.
type Connection struct {
	PgSQLConn *gorm.DB

	// Changes, when set, hears every write a repository built from Repox
	// commits, beside the observers Observe added.
	Changes repox.ChangeObserver
	// References, when set, checks references to resources other services
	// keep, for every repository built from Repox.
	References *repox.References
	// Projections keeps projection tables current with every write, inside
	// the write's transaction.
	Projections *repox.Projections

	// observers hear every write as Changes does, added through Observe.
	observers observerList
	// cacheProvider is the cache OpenCache opened, nil when it is off.
	cacheProvider cache.Provider
}

// observerList is the observers Observe added, safe to read while one is
// being added.
type observerList struct {
	mu   sync.RWMutex
	list []repox.ChangeObserver
}

// Observe makes o hear every write a repository or Batch built from this
// connection's Repox commits -- built before this call or after.
func (c *Connection) Observe(o repox.ChangeObserver) {
	c.observers.mu.Lock()
	defer c.observers.mu.Unlock()
	c.observers.list = append(c.observers.list, o)
}

// CacheProvider is the cache the connection opened, nil when [cache] is off.
func (c *Connection) CacheProvider() cache.Provider { return c.cacheProvider }

// changes is the connection's fan-out of one write to Changes and every
// observer.
type changes struct{ c *Connection }

func (ch changes) Changed(ctx context.Context, name string) {
	if ch.c.Changes != nil {
		ch.c.Changes.Changed(ctx, name)
	}
	ch.c.observers.mu.RLock()
	list := ch.c.observers.list
	ch.c.observers.mu.RUnlock()
	for _, o := range list {
		o.Changed(ctx, name)
	}
}

// Repox is the connection as the generated repositories take it.
func (c *Connection) Repox() repox.Conn {
	return repox.Conn{Gorm: c.PgSQLConn, Changes: changes{c}, References: c.References, Projections: c.Projections}
}

// Close closes the database handle.
func (c *Connection) Close() error {
	if c.PgSQLConn == nil {
		return nil
	}
	sqlDB, err := c.PgSQLConn.DB()
	if err != nil {
		return err
	}
	return sqlDB.Close()
}

// Postgres is the configured connection settings, for a tool that opens its
// own (a migration).
func Postgres() config.PostgresConfig { return config.Get().Database.Postgres }
