// {{ .GoName }}Hooks is the business logic {{ .GoName }}Server runs around its
// standard methods. Embed Nop{{ .GoName }}Hooks and implement only the hooks
// you need. An error a hook returns fails the call, rendered by the server's
// problem.Translator: a *problem.Problem (servicex.BadField, Missing,
// Blocked), an error wrapping a registered sentinel, or a gRPC status.
type {{ .GoName }}Hooks interface {
{{- range .Hooks }}
	// {{ .Doc }}
	{{ .Name }}({{ .Params }}) error
{{- end }}
}

// Nop{{ .GoName }}Hooks implements every hook as doing nothing.
type Nop{{ .GoName }}Hooks struct{}

var _ {{ .GoName }}Hooks = Nop{{ .GoName }}Hooks{}
{{ range .Hooks }}
// {{ .Name }} does nothing.
func (Nop{{ $s.GoName }}Hooks) {{ .Name }}({{ .Params }}) error { return nil }
{{ end }}
// {{ .GoName }}Server serves {{ .FullName }}'s AIP standard methods over the
// generated repositories.
{{- if .Custom }}
//
// Custom methods are answered by the embedded Unimplemented{{ .GoName }}Server
// until you write them: embed *{{ .GoName }}Server in a type of your own and
// define {{ range $i, $m := .Custom }}{{ if $i }}, {{ end }}{{ $m }}{{ end }} on it. Define a standard method there too to
// replace the generated one.
{{- end }}
type {{ .GoName }}Server struct {
	{{ .Grpc }}.Unimplemented{{ .GoName }}Server

	repos {{ .GoName }}Repositories
	hooks {{ .GoName }}Hooks
	opts  servicex.Options
}

var _ {{ .Grpc }}.{{ .GoName }}Server = (*{{ .GoName }}Server)(nil)

// New{{ .GoName }}Server returns the {{ .GoName }}Server over repos running hooks
// (nil runs none). Errors carry the ErrorInfo domain {{ quote .Domain }}
// unless servicex.WithTranslator says otherwise.
func New{{ .GoName }}Server(repos {{ .GoName }}Repositories, hooks {{ .GoName }}Hooks, opts ...servicex.Option) *{{ .GoName }}Server {
	if hooks == nil {
		hooks = Nop{{ .GoName }}Hooks{}
	}
	return &{{ .GoName }}Server{
		repos: repos,
		hooks: hooks,
		opts:  servicex.Apply(servicex.Options{Translator: servicex.NewTranslator({{ quote .Domain }})}, opts),
	}
}

// Options are the server's options, for a custom method that traces and
// renders its errors the way the generated ones do (Options().Run).
func (s *{{ .GoName }}Server) Options() servicex.Options { return s.opts }

// Repositories are the repositories the server persists through.
func (s *{{ .GoName }}Server) Repositories() {{ .GoName }}Repositories { return s.repos }
