// {{ $r.Singular }} (AIP-122); empty has the repository mint an id.{{ end }}
func (s *{{ $s.GoName }}Server) {{ $m.GoName }}(ctx context.Context, req *{{ $m.Req }}) (*{{ $m.Resp }}, error) {
	var out *{{ $m.Resp }}
	err := s.opts.Run(ctx, {{ quote $s.GoName }}, {{ quote $m.GoName }}, func(ctx context.Context) (err error) {
