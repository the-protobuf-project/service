{{- define "methodUpdate" }}{{ $s := .S }}{{ $m := .M }}{{ $r := .R }}
// {{ $m.GoName }} is AIP-134's Update: the fields update_mask names ("*" for
// every mutable one, absent for the ones the request sets), guarded by the
// record's etag when it carries one.
func (s *{{ $s.GoName }}Server) {{ $m.GoName }}(ctx context.Context, req *{{ $m.Req }}) (*{{ $m.Resp }}, error) {
	var out *{{ $m.Resp }}
	err := s.opts.Run(ctx, {{ quote $s.GoName }}, {{ quote $m.GoName }}, func(ctx context.Context) (err error) {
		in := req.{{ $m.Body }}
		if in == nil {
			return servicex.BadField(servicex.ReasonRequiredField, {{ quote $m.BodyField }}, "{{ $m.BodyField }} is required", "Send the {{ $r.Singular }} to write")
		}
		name := in.GetName()
		if err := servicex.CheckName("{{ $m.BodyField }}.name", name, false, {{ $r.Var }}Collections...); err != nil {
			return err
		}
		paths, err := servicex.UpdatePaths(in, {{ if $m.UpdateMask }}req.{{ $m.UpdateMask }}{{ else }}nil{{ end }}, {{ quote $m.BodyField }}, {{ $r.Var }}OutputOnly)
		if err != nil {
			return err
		}
{{- if or $r.HasImmut $m.AllowMissing $m.ValidateOnly }}
		if {{ if $r.HasImmut }}servicex.TouchesAny(paths, {{ $r.Var }}Immutable){{ else }}false{{ end }}{{ if $m.AllowMissing }} || req.{{ $m.AllowMissing }}{{ end }}{{ if $m.ValidateOnly }} || req.{{ $m.ValidateOnly }}{{ end }} {
			existing, err := s.repos.{{ $r.Field }}.Get(ctx, name)
{{- if $m.AllowMissing }}
			if req.{{ $m.AllowMissing }} && servicex.IsNotFound(err) {
				// AIP-134 allow_missing: an update of nothing creates it.
				out, err = s.create{{ $r.GoName }}(ctx, servicex.ParentOf(name), name, proto.Clone(in).(*{{ $r.PB }}), {{ if $m.ValidateOnly }}req.{{ $m.ValidateOnly }}{{ else }}false{{ end }})
				return err
			}
{{- end }}
			if err != nil {
				return servicex.NotFoundAs(err, {{ $r.Var }}Type, name)
			}
{{- if $r.HasImmut }}
			if err := servicex.CheckImmutable({{ quote $m.BodyField }}, existing, in, paths, {{ $r.Var }}Immutable); err != nil {
				return err
			}
{{- end }}
{{- if $m.ValidateOnly }}
			if req.{{ $m.ValidateOnly }} {
{{- if $r.HasEtag }}
				if err := servicex.CheckEtag({{ $r.Var }}Type, name, in.GetEtag(), existing.GetEtag()); err != nil {
					return err
				}
{{- end }}
				preview := proto.Clone(existing).(*{{ $r.PB }})
				servicex.Merge(preview, in, paths)
				if err := s.hooks.Validate{{ $r.GoName }}(ctx, servicex.OpUpdate, preview, paths); err != nil {
					return err
				}
				if err := s.hooks.BeforeUpdate{{ $r.GoName }}(ctx, preview, paths); err != nil {
					return err
				}
				out = preview
				return nil
			}
{{- else }}
			_ = existing
{{- end }}
		}
{{- end }}
		if err := s.hooks.Validate{{ $r.GoName }}(ctx, servicex.OpUpdate, in, paths); err != nil {
			return err
		}
		if err := s.hooks.BeforeUpdate{{ $r.GoName }}(ctx, in, paths); err != nil {
			return err
		}
		out, err = s.repos.{{ $r.Field }}.Update(ctx, in, paths)
		if err != nil {
			return servicex.NotFoundAs(err, {{ $r.Var }}Type, name)
		}
		return s.hooks.AfterUpdate{{ $r.GoName }}(ctx, out)
	})
	if err != nil {
		return nil, err
	}
	return out, nil
}
{{ end }}

{{- define "precheck" }}{{ $m := .M }}{{ $r := .R }}
{{- if or $m.Etag $m.ValidateOnly }}
		var existing *{{ $r.PB }}
		if {{ if $m.Etag }}req.{{ $m.Etag }} != ""{{ else }}false{{ end }}{{ if $m.ValidateOnly }} || req.{{ $m.ValidateOnly }}{{ end }} {
			var err error
			existing, err = s.repos.{{ $r.Field }}.Get(ctx, name)
{{- if $m.AllowMissing }}
			if req.{{ $m.AllowMissing }} && servicex.IsNotFound(err) {
				return nil
			}
{{- end }}
			if err != nil {
				return servicex.NotFoundAs(err, {{ $r.Var }}Type, name)
			}
{{- if and $m.Etag $r.HasEtag }}
			if err := servicex.CheckEtag({{ $r.Var }}Type, name, req.{{ $m.Etag }}, existing.GetEtag()); err != nil {
				return err
			}
{{- end }}
		}
		_ = existing
{{- end }}
{{- end }}

{{- define "methodDelete" }}{{ $s := .S }}{{ $m := .M }}{{ $r := .R }}
// {{ $m.GoName }} is AIP-135's Delete: a soft delete
// (AIP-164) when the {{ $r.Singular }} has a delete_time, so Get still
// returns it and Undelete restores it.
func (s *{{ $s.GoName }}Server) {{ $m.GoName }}(ctx context.Context, req *{{ $m.Req }}) (*{{ if $m.ReturnsEmpty }}{{ $s.EmptyQ }}.Empty{{ else }}{{ $m.Resp }}{{ end }}, error) {
{{- if not $m.ReturnsEmpty }}
	var out *{{ $m.Resp }}
{{- end }}
	err := s.opts.Run(ctx, {{ quote $s.GoName }}, {{ quote $m.GoName }}, func(ctx context.Context) error {
		name := req.{{ $m.Name }}
		if err := servicex.CheckName("name", name, false, {{ $r.Var }}Collections...); err != nil {
			return err
		}
{{- template "precheck" . }}
		if err := s.hooks.BeforeDelete{{ $r.GoName }}(ctx, name, {{ if $m.Force }}req.{{ $m.Force }}{{ else }}false{{ end }}); err != nil {
			return err
		}
{{- if $m.ValidateOnly }}
		if req.{{ $m.ValidateOnly }} {
{{- if not $m.ReturnsEmpty }}
			out = existing
{{- end }}
			return nil
		}
{{- end }}
		err := s.repos.{{ $r.Field }}.Delete(ctx, name)
{{- if $m.AllowMissing }}
		if req.{{ $m.AllowMissing }} && servicex.IsNotFound(err) {
			return nil
		}
{{- end }}
		if err != nil {
			return servicex.NotFoundAs(err, {{ $r.Var }}Type, name)
		}
{{- if not $m.ReturnsEmpty }}
		out, err = s.repos.{{ $r.Field }}.Get(ctx, name)
		if err != nil && !servicex.IsNotFound(err) {
			return err
		}
{{- end }}
		return s.hooks.AfterDelete{{ $r.GoName }}(ctx, name)
	})
	if err != nil {
		return nil, err
	}
{{- if $m.ReturnsEmpty }}
	return &{{ $s.EmptyQ }}.Empty{}, nil
{{- else }}
	if out == nil {
		// allow_missing on a name that was never there: nothing to return.
		out = &{{ $m.Resp }}{Name: req.{{ $m.Name }}}
	}
	return out, nil
{{- end }}
}
{{ end }}

{{- define "methodUndelete" }}{{ $s := .S }}{{ $m := .M }}{{ $r := .R }}
// {{ $m.GoName }} is AIP-164's Undelete: the soft-deleted {{ $r.Singular }}
// restored. ALREADY_EXISTS when it is not deleted.
func (s *{{ $s.GoName }}Server) {{ $m.GoName }}(ctx context.Context, req *{{ $m.Req }}) (*{{ $m.Resp }}, error) {
	var out *{{ $m.Resp }}
	err := s.opts.Run(ctx, {{ quote $s.GoName }}, {{ quote $m.GoName }}, func(ctx context.Context) (err error) {
		name := req.{{ $m.Name }}
