// create{{ $r.GoName }} is AIP-133's create of in under parent, named name
// ("" has the repository mint an id), shared by Create{{ $r.GoName }} and an
// allow_missing update.
func (s *{{ $s.GoName }}Server) create{{ $r.GoName }}(ctx context.Context, parent, name string, in *{{ $r.PB }}, validateOnly bool) (*{{ $r.PB }}, error) {
	servicex.ClearOutputOnly(in, {{ $r.Var }}OutputOnly)
	in.Name = name
	if err := servicex.Required(in, {{ quote $r.Singular }}, {{ $r.Var }}Required); err != nil {
		return nil, err
	}
{{- if $r.Parented }}
	if err := s.hooks.ParentCheck{{ $r.GoName }}(ctx, servicex.OpCreate, parent); err != nil {
		return nil, err
	}
{{- end }}
	if err := s.hooks.Validate{{ $r.GoName }}(ctx, servicex.OpCreate, in, nil); err != nil {
		return nil, err
	}
	if err := s.hooks.BeforeCreate{{ $r.GoName }}(ctx, parent, in); err != nil {
		return nil, err
	}
	if validateOnly {
		return in, nil
	}
	out, err := s.repos.{{ $r.Field }}.Create(ctx, {{ if $r.Parented }}parent, {{ end }}in)
	if err != nil {
		return nil, servicex.AlreadyExistsAs(err, {{ $r.Var }}Type, name, "Choose another {{ $r.Singular }}_id, or leave it empty to have one assigned")
	}
	if err := s.hooks.AfterCreate{{ $r.GoName }}(ctx, out); err != nil {
		return nil, err
	}
	return out, nil
}
{{ end }}
