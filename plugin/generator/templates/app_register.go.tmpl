{{ .Banner }}

package server

// register.go puts every service on the server's three surfaces -- gRPC, the
// REST gateway and MCP -- through each package's generated RegisterAll, with
// any Overrides in place of the generated servers.

import (
{{- range .Imports }}
	{{ . }}
{{- end }}
)

// Options are the hybrid-server options that serve every service on gRPC,
// REST and MCP, then every Extension's and the Provision's own.
func (s *Services) Options() []grpc.Option {
	var opts []grpc.Option
	for _, o := range [][]grpc.Option{
{{- range .Packages }}
		{{ .Pkg }}.RegisterAll({{ .Pkg }}.Servers{ {{- range $i, $s := .Services }}{{ if $i }}, {{ end }}{{ $s.GoName }}: s.registered{{ $s.Field }}(){{ end -}} }),
{{- end }}
	} {
		opts = append(opts, o...)
	}
	for _, e := range s.provision.Extensions {
		opts = append(opts, e.Options(s)...)
	}
	return append(opts, s.provision.Options...)
}

// Register registers every service on a standalone gRPC server, the one a
// test serves over bufconn.
func (s *Services) Register(g *grpc.GRPCServer) {
{{- range .Packages }}
	{{ .Pkg }}.RegisterGRPC(g, {{ .Pkg }}.Servers{ {{- range $i, $s := .Services }}{{ if $i }}, {{ end }}{{ $s.GoName }}: s.registered{{ $s.Field }}(){{ end -}} })
{{- end }}
}
